# ---------- 运行时数据 ----------
# 数据库、日志、缩略图、备份、回收站：属于用户数据，不进版本库
data/

# ---------- 内置运行时与第三方二进制 ----------
# runtime/node.exe 约 89MB、tools/ffmpeg.exe + ffprobe.exe 约 200MB，
# 均为不会变动的第三方二进制，体积大且可重新获取，
# 统一用 RUNTIME.txt 记录版本号与来源，不进版本库。
runtime/
tools/ffmpeg.exe
tools/ffprobe.exe

# ---------- 用户素材 ----------
# 生成的图片/视频/音频，体积大且可再生
素材/

# ---------- 开发期调试残留 ----------
# 浏览器自动化 profile，单个就 489MB
work/

# ---------- 历史备份文件 ----------
# 已迁移到 _archive/ 归档，不纳入版本管理
*.bak
*.bak-*
_archive/

# ---------- 临时与系统文件 ----------
.tmp-test/
# 变异测试的临时工作区（改写源码 → 跑测试 → 还原，里面的 .orig.js 是还原用的副本）
.tmp-mut/
*.tmp
*.log
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
